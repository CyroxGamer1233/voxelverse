{
  "name": "voxelverse-all-phases",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server/server.js\"",
    "dev:static": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:static": "vite build --mode static",
    "start": "node server/server.js",
    "check": "node --check client/main.js && node --check client/game.js && node --check server/server.js"
  },
  "dependencies": {
    "three": "^0.160.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vite": "^5.4.0"
  }
}
